# Replace the placeholders with your MongoDB Atlas connection details.
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=menuqr
# Optional: set only when your system DNS times out on Atlas SRV/TXT queries.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
API_PORT=3001
ADMIN_PASSWORD=change-this-admin-password
# Gmail alerts use an App Password from the sending account (with 2-Step Verification enabled).
ADMIN_EMAIL=
SMTP_USER=
SMTP_APP_PASSWORD=
